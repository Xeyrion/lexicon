{
  "name": "lexicon",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort --open",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "docs:check": "node scripts/check-docs.mjs",
    "game:data": "node scripts/build-game-data.mjs",
    "translate:check": "node scripts/translate-check.mjs",
    "translate:doc": "node scripts/translate-doc.mjs",
    "pretest": "node scripts/check-docs.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dicts": "node scripts/build-dicts.mjs",
    "reader-data": "node scripts/build-reader-data.mjs",
    "preview": "vite preview",
    "serve": "npm run build && npm run build:server && node dist-server/standalone.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:reader": "node scripts/smoke-reader.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:books": "node scripts/smoke-books.mjs",
    "smoke:stories": "node scripts/smoke-stories.mjs",
    "story:check": "node scripts/story-tools.mjs check",
    "story:map": "node scripts/story-tools.mjs map",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/gentium-plus": "^5.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
