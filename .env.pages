# GitHub Pages project site: https://<user>.github.io/<repo>/
# Only used by `npm run build:pages`; everything else builds with base "/".
#
# Relative rather than "/lexicon/" on purpose: Pages keeps the repository's
# capitalisation in the URL, and a wrong case 404s every asset. Hash routing
# never changes the pathname, so "./" always resolves to the right place.
VITE_BASE=./
